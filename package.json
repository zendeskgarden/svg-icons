{
  "name": "@zendeskgarden/svg-icons",
  "version": "9.0.0-next.0",
  "description": "Garden SVG icons",
  "license": "Apache-2.0",
  "author": "Zendesk Garden <garden@zendesk.com>",
  "homepage": "https://garden.zendesk.com/",
  "repository": "https://github.com/zendeskgarden/svg-icons",
  "bugs": {
    "url": "https://github.com/zendeskgarden/svg-icons/issues"
  },
  "main": "dist/index.svg",
  "files": [
    "codemods",
    "dist",
    "src",
    "!codemods/**/*.test.mjs",
    "!codemods/**/__fixtures__",
    "!src/.stories"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:demo": "storybook build -o demo",
    "build:migration-doc": "node scripts/build-migration-doc.mjs",
    "format": "prettier-package-json --write && prettier --log-level warn ./ --write && npm run format:optimize -- --quiet",
    "format:optimize": "svgo src --recursive",
    "lint": "npm run lint:js && npm run lint:svg",
    "lint:js": "eslint --max-warnings 0",
    "lint:svg": "svglint src/**/*.svg",
    "prepare": "husky && npm run build",
    "start": "npm run build && storybook dev -p 6006",
    "tag": "node scripts/tag.mjs",
    "test": "npm run build:migration-doc && npm run format && npm run lint && npm run test:scripts && npm run test:codemods && git diff --quiet",
    "test:codemods": "node --test \"codemods/**/*.test.mjs\"",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@vitejs/plugin-react-swc": "4.3.3",
    "@zendeskgarden/eslint-config": "48.0.1",
    "@zendeskgarden/react-grid": "9.16.1",
    "@zendeskgarden/react-theming": "9.16.1",
    "@zendeskgarden/react-typography": "9.16.1",
    "@zendeskgarden/scripts": "2.5.3",
    "commit-and-tag-version": "13.2.1",
    "envalid": "8.2.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jscodeshift": "17.4.0",
    "prettier": "3.9.9",
    "prettier-package-json": "2.8.0",
    "prop-types": "15.8.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "7.8.5",
    "storybook": "10.6.1",
    "styled-components": "6.5.3",
    "svg-sprite": "2.0.2",
    "svg4everybody": "2.1.9",
    "svglint": "4.2.1",
    "svgo": "4.1.0",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  },
  "keywords": [
    "garden",
    "icons",
    "svg",
    "zendesk"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
